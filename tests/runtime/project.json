{
    "name": "@eventiva/runtime-tests",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "tests/runtime/src",
    "tags": ["type:test", "layer:backend", "capability:test"],
    "implicitDependencies": ["@eventiva/resource-tests", "@eventiva/telemetry-tests"],
    "targets": {
        "test": {
            "inputs": [
                "default",
                "^default",
                { "fileset": "{projectRoot}/tsconfig.spec.json", "dependencies": true },
                { "fileset": "{projectRoot}/tsconfig.storybook.json", "dependencies": true },
                { "json": "{workspaceRoot}/tsconfig.json", "fields": ["compilerOptions"] },
                { "externalDependencies": ["vitest"] },
                { "env": "CI" },
                { "dependentTasksOutputFiles": "**/*.js", "transitive": true }
            ]
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": { "command": "tsc -p tests/runtime/tsconfig.json --noEmit", "cwd": "{workspaceRoot}" },
            "dependsOn": ["^build"]
        },
        "parity": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "cwd": "tests/runtime",
                "command": "pnpm exec vitest run src/parity.spec.ts --coverage.enabled=false"
            }
        }
    }
}
