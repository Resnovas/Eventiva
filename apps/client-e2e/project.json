{
    "name": "@eventiva/client-e2e",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/client-e2e/src",
    "implicitDependencies": [
        "@eventiva/client"
    ],
    "tags": [
        "type:test",
        "layer:frontend",
        "capability:app"
    ],
    "targets": {
        "smoke": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "@eventiva/client"
                    ],
                    "target": "export-web"
                }
            ],
            "outputs": [
                "{projectRoot}/test-output"
            ],
            "options": {
                "command": "playwright test --config apps/client-e2e/playwright.config.mts"
            }
        }
    }
}
