{
    "name": "@eventiva/server",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/server/src",
    "tags": ["type:platform", "layer:backend", "capability:app"],
    "targets": {
        "telemetry": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["build", "^build"],
            "options": {
                "command": "node apps/server/dist/telemetry-entry.js",
                "env": { "telemetry_timeoutMs": "10000" }
            }
        },
        "test": {
            "cache": false,
            "dependsOn": ["cluster-conformance"]
        },
        "cluster-conformance": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["build", "^build"],
            "options": {
                "command": "node apps/server/tests/two-runners.mjs"
            }
        },
        "parity": {
            "executor": "nx:run-commands",
            "dependsOn": ["build", "^build"],
            "options": {
                "command": "node apps/server/dist/main.js"
            }
        },
        "smoke": {
            "executor": "nx:run-commands",
            "dependsOn": ["build", "^build"],
            "options": {
                "command": "node apps/server/dist/main.js"
            }
        },
        "keycloak-conformance": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "vitest run --config apps/server/vitest.keycloak.mts",
                "cwd": "{workspaceRoot}"
            }
        },
        "http-batch-conformance": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "vitest run --config apps/server/vitest.config.mts apps/server/tests/http-action-batch.spec.ts --coverage.include=apps/server/src/http-action-batch.ts",
                "cwd": "{workspaceRoot}"
            }
        },
        "http-conformance": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "vitest run --config apps/server/vitest.config.mts apps/server/tests/http-actions.spec.ts --coverage.include=apps/server/src/http-actions.ts --coverage.include=apps/server/src/http-entry.ts",
                "cwd": "{workspaceRoot}"
            }
        }
    }
}
