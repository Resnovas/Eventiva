{
    "name": "@eventiva/server",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/server/src",
    "tags": ["type:platform", "layer:backend", "capability:app"],
    "targets": {
        "test": { "cache": false, "dependsOn": ["cluster-conformance"] },
        "cluster-conformance": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["build", "^build"],
            "options": { "command": "node apps/server/tests/two-runners.mjs" }
        },
        "parity": {
            "executor": "nx:run-commands",
            "dependsOn": ["build", "^build"],
            "options": { "command": "node apps/server/dist/main.js" }
        },
        "smoke": {
            "executor": "nx:run-commands",
            "dependsOn": ["build", "^build"],
            "options": { "command": "node apps/server/dist/main.js" }
        }
    }
}
