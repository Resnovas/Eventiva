{
  "compilerOptions": {
    "plugins": [
    ],
    "baseUrl": ".",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "downlevelIteration": true,
    "customConditions": ["@eventiva/source"],
    "paths": {
      "@eventiva/core": ["packages/core/src/index.ts"],
      "@eventiva/databases.pg": ["packages/databases/pg/src/index.ts"],
      "@eventiva/platforms.postgresql": ["packages/platforms/postgresql/src/index.ts"],
      "@eventiva/platforms.postgresql/platform": ["packages/platforms/postgresql/src/platform.ts"],
      "@eventiva/platforms.mysql": ["packages/platforms/mysql/src/index.ts"],
      "@eventiva/platforms.mysql/platform": ["packages/platforms/mysql/src/platform.ts"],
      "@eventiva/mobile": ["apps/mobile/src/index.ts"],
      "@eventiva/api": ["libs/api/src/index.ts"],
      "@eventiva/domain-venue": ["libs/domain/venue/src/index.ts"],
      "@eventiva/domain-vendor": ["libs/domain/vendor/src/index.ts"],
      "@eventiva/domain-event": ["libs/domain/event/src/index.ts"],
      "@eventiva/domain-gdpr": ["libs/domain/gdpr/src/index.ts"],
      "@eventiva/domain-auth": ["libs/domain/auth/src/index.ts"]
    }
  }
}
