#!/usr/bin/env bash
set -euo pipefail

# No services or user authentication are required. Do not reinstall anything
# on wake: .agents/setup installs the toolchain, dependencies and Chromium.
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"
package_manager="$(node -p 'JSON.parse(require("fs").readFileSync("package.json", "utf8")).packageManager')"
if [[ "$(node --version)" != "v$(cat .node-version)" || \
      "$(pnpm --version)" != "${package_manager#pnpm@}" || \
      ! -d node_modules/.pnpm ]]; then
    echo 'Orb toolchain is missing or stale; run .agents/setup.' >&2
    exit 1
fi
node --run check
sh tools/graphify/graphify update || echo 'Graph navigation unavailable; run sh tools/graphify/graphify setup.' >&2
echo 'Orb repository ready; run node --run verify for the full gate.'
