#!/usr/bin/env bash
set -euo pipefail

# No application dependencies, services or user authentication are required.
# Do not reinstall anything on wake.
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"
package_manager="$(node -p 'JSON.parse(require("fs").readFileSync("package.json", "utf8")).packageManager')"
if [[ "$(node --version)" != "v$(cat .node-version)" || \
      "$(pnpm --version)" != "${package_manager#pnpm@}" ]]; then
    echo 'Orb toolchain is missing or stale; run .agents/setup.' >&2
    exit 1
fi
node --run check
echo 'Orb repository ready; application foundation pending EVE-244.'
