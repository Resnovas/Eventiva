{
    "name": "@eventiva/schema",
    "version": "0.0.1",
    "private": true,
    "description": "Portable, Drizzle-neutral Eventiva schema declarations, starting with dynamic module manifests.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
