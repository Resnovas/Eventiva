{
    "name": "@eventiva/integrations.posthog.server",
    "version": "0.0.1",
    "private": true,
    "description": "PostHog as an OpenFeature provider for the server. Nothing is sent until credentials are configured.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./telemetry": {
            "@eventiva/source": "./src/telemetry.ts",
            "types": "./dist/telemetry.d.ts",
            "default": "./dist/telemetry.js"
        },
        "./flags": {
            "@eventiva/source": "./src/flags.ts",
            "types": "./dist/flags.d.ts",
            "default": "./dist/flags.js"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@eventiva/contracts": "workspace:*",
        "@openfeature/core": "1.12.0",
        "@openfeature/server-sdk": "1.23.0",
        "@posthog/openfeature-node-provider": "0.1.3",
        "posthog-node": "5.74.0"
    },
    "peerDependencies": {
        "effect": "catalog:"
    },
    "devDependencies": {
        "effect": "catalog:"
    }
}
