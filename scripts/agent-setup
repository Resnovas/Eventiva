#!/bin/sh
# Sets up this checkout for an agent on a machine that already has the pinned
# Node (.node-version) and pnpm (packageManager in package.json). Idempotent.
# Amp orbs provision the toolchain with .agents/setup instead. Windows: run the
# commands below by hand.
set -eu
cd "$(dirname "$0")/.."
CI=true pnpm install --frozen-lockfile
node --run setup
node --run check
echo "agent-setup: ok"
